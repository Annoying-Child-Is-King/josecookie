function tilePx(v){ return v*TS+TS/2; }
/* Classic look: walls are just outlined corridor boundaries on a black
   background, not filled blocks. For each wall cell we draw only the
   edges that face an open (path) cell -- shared wall-to-wall edges are
   never drawn, so neighbouring wall cells merge into one continuous
   tube instead of a grid of separate squares. Round caps/joins on the
   shared corner points give the smooth rounded-corner tube look. */
function strokeWallEdges(lw){
  ctx.lineWidth = lw;
  ctx.beginPath();
  for (var y=0;y<ROWS;y++){
    for (var x=0;x<COLS;x++){
      if (!isWall(x,y)) continue;
      var px=x*TS, py=y*TS;
      if (!isWall(x,y-1)){ ctx.moveTo(px,py); ctx.lineTo(px+TS,py); }
      if (!isWall(x,y+1)){ ctx.moveTo(px,py+TS); ctx.lineTo(px+TS,py+TS); }
      if (!isWall(x-1,y)){ ctx.moveTo(px,py); ctx.lineTo(px,py+TS); }
      if (!isWall(x+1,y)){ ctx.moveTo(px+TS,py); ctx.lineTo(px+TS,py+TS); }
    }
  }
  ctx.stroke();
}
