function drawArrow(px,py,dir,size,color){
  var ang = {L:Math.PI, R:0, U:-Math.PI/2, D:Math.PI/2, N:0}[dir]||0;
  ctx.save();
  ctx.translate(px,py);
  ctx.rotate(ang);
  ctx.fillStyle = color;
  ctx.beginPath();
  ctx.moveTo(size,0);
  ctx.lineTo(-size*0.6, -size*0.7);
  ctx.lineTo(-size*0.6, size*0.7);
  ctx.closePath();
