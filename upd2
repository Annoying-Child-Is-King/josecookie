  if (options.length===0){
    options = ['U','L','D','R'].filter(function(d){ return canMove(g.x,g.y,d,true); });
  }
  if (options.length===0) return g.dir;
  if (!g.recent) g.recent = [];
  if (g.frightened && !g.eaten){
    var pick = options[Math.floor(Math.random()*options.length)];
    rememberTile(g, gx, gy);
