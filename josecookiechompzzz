function tilePx(v){ return v*TS+TS/2; }
function drawMaze(){
  ctx.fillStyle='#000'; ctx.fillRect(0,0,W,H);
  for (var y=0;y<ROWS;y++){
    for (var x=0;x<COLS;x++){
      if (MAZE[y][x]==='#'){
        ctx.fillStyle='#1c2bd6';
        var pad=1.5;
        roundRect(x*TS+pad, y*TS+pad, TS-2*pad, TS-2*pad, 4);
        ctx.fill();
