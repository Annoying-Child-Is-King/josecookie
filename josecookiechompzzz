}
function drawGhost(g){
  var px = tilePx(g.x), py = tilePx(g.y);
  var s = TS*1.05;
  ctx.save();
  ctx.beginPath();
  ctx.arc(px,py,s/2,0,Math.PI*2);
  ctx.closePath();
  ctx.clip();
  if (g.frightened){
    ctx.fillStyle = (frightTimer<1500 && Math.floor(frightTimer/150)%2===0) ? '#fff' : '#2222ee';
