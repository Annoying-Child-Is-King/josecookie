  ctx.save();
  ctx.beginPath();
  ctx.arc(px,py,s/2,0,Math.PI*2);
  ctx.closePath();
  ctx.clip();
  if (imgPacman.complete) ctx.drawImage(imgPacman, px-s/2, py-s/2, s, s);
  ctx.restore();
  var off = { L:{x:-s*0.62,y:0}, R:{x:s*0.62,y:0}, U:{x:0,y:-s*0.62}, D:{x:0,y:s*0.62}, N:{x:s*0.62,y:0} }[pacman.dir]||{x:s*0.62,y:0};
