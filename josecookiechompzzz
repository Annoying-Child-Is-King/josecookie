function playOw(){ try { sndOw.currentTime=0; var p=sndOw.play(); if (p&&p.catch) p.catch(function(){}); } catch(e){} }
function playOwy(){ try { sndOwy.currentTime=0; var p=sndOwy.play(); if (p&&p.catch) p.catch(function(){}); } catch(e){} }
var imgPacman = new Image(); imgPacman.src = IMG_PACMAN;
var imgTitle  = new Image(); imgTitle.src  = IMG_TITLE;
var imgMilk   = new Image(); imgMilk.src   = IMG_MILK;
var imgCookie = new Image(); imgCookie.src = IMG_COOKIE;
var imgGhosts = IMG_GHOSTS.map(function(s){ var im=new Image(); im.src=s; return im; });
