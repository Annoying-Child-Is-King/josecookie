    frightTimer -= dt;
    if (frightTimer<=0){
      ghosts.forEach(function(g){ g.frightened=false; });
    }
  }
  ghosts.forEach(function(g){
    if (!g.released){
      if (dotsEatenCount>=g.releaseAt) g.released = true;
      else return; /* still waiting inside the house */
