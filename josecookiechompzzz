        var s=TS*0.62;
        ctx.drawImage(imgCookie, x*TS+(TS-s)/2, y*TS+(TS-s)/2, s, s);
      } else if (v===2 && imgMilk.complete){
        var pulse = 0.85+0.15*Math.sin(t/180);
