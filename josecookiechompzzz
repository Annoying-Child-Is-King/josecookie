var CENTER_EPS = 0.14;
function nearCenter(e){
  return Math.abs(e.x-Math.round(e.x))<CENTER_EPS && Math.abs(e.y-Math.round(e.y))<CENTER_EPS;
}
/* Edge-triggered: true only on the frame an entity FIRST comes within
   CENTER_EPS of a tile center, not on every subsequent frame it stays
   within that band (prevents snap-back oscillation). */
function arrivedAtCenter(e){
  var near = nearCenter(e);
  var arrived = near && !e.wasCentered;
  e.wasCentered = near;
  return arrived;
}
function canMove(x,y,dir,isGhost){
  var d = DIRS[dir];
  if (!d || (d.x===0&&d.y===0)) return false;
  return !blockedFor(Math.round(x)+d.x, Math.round(y)+d.y, isGhost);
}
function wrapX(e){
  if (e.x < -0.5) e.x = COLS-0.5;
  if (e.x > COLS-0.5) e.x = -0.5;
}
function ghostTarget(g){
  if (g.eaten) return {x:11, y:11};
  if (g.frightened) return null; // random movement handled separately
  if (mode==='scatter') return g.corner;
  var px = Math.round(pacman.x), py = Math.round(pacman.y);
  var pd = DIRS[pacman.dir]||DIRS.N;
  if (g.personality===0){ // direct chaser
    return {x:px, y:py};
  }
  if (g.personality===1){ // ambusher: 4 ahead of pacman
    return {x:px+pd.x*4, y:py+pd.y*4};
  }
  if (g.personality===2){ // flanker using ghost0 position
    var g0 = ghosts[0];
    var ax = px+pd.x*2, ay = py+pd.y*2;
    return {x: ax + (ax-Math.round(g0.x)), y: ay + (ay-Math.round(g0.y))};
  }
  var dist = Math.hypot(g.x-pacman.x, g.y-pacman.y);
