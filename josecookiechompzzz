  ctx.moveTo(size,0);
  ctx.lineTo(-size*0.6, -size*0.7);
  ctx.lineTo(-size*0.6, size*0.7);
  ctx.closePath();
  ctx.fill();
  ctx.restore();
}
function drawPacman(){
  var px = tilePx(pacman.x), py = tilePx(pacman.y);
