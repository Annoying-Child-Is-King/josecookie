    if (d===opposite(g.dir)) return false;
    return canMove(g.x,g.y,d,true);
  });
  if (options.length===0){
    options = ['L','R','U','D'].filter(function(d){ return canMove(g.x,g.y,d,true); });
  }
  if (options.length===0) return g.dir;
  if (g.frightened && !g.eaten){
    return options[Math.floor(Math.random()*options.length)];
  }
  var target = ghostTarget(g);
  var best=null, bestD=1e18;
  options.forEach(function(d){
    var dd = DIRS[d];
    var nx=gx+dd.x, ny=gy+dd.y;
    var dist = (nx-target.x)*(nx-target.x)+(ny-target.y)*(ny-target.y);
